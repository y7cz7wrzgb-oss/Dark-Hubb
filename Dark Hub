-- Floating robot button: tap to open / close the UI (drag to move)
---------------------------------------------------------------------
do
    local UIS = game:GetService("UserInputService")
    local parent = (gethui and gethui()) or game:GetService("CoreGui")

    local old = parent:FindFirstChild("DarkHubToggle")
    if old then old:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name = "DarkHubToggle"
    gui.ResetOnSpawn = false
    gui.DisplayOrder = 999
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    pcall(function()
        if syn and syn.protect_gui then syn.protect_gui(gui) end
    end)
    gui.Parent = parent

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.fromOffset(52, 52)
    btn.Position = UDim2.new(0, 20, 0.5, -26)
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
    btn.AutoButtonColor = false
    btn.Text = "🤖"
    btn.TextSize = 28
    btn.Parent = gui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(1, 0)
    corner.Parent = btn

    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(130, 90, 255)
    stroke.Thickness = 2
    stroke.Parent = btn

    local dragging, moved, dragStart, startPos = false, false, nil, nil

    btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, moved = true, false
            dragStart, startPos = input.Position, btn.Position
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if delta.Magnitude > 6 then moved = true end
            if moved then
                btn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            if not moved then
                Window:Minimize() -- toggles open/closed
            end
        end
    end)
end

