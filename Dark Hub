local function raidIslands()
    local loc = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations")
    local list = {}
    if loc then
        for _, v in ipairs(loc:GetChildren()) do
            if v.Name:find("^Island %d") and v:IsA("BasePart") then table.insert(list, v) end
        end
    end
    table.sort(list, function(a, b) return a.Name < b.Name end)
    return list
end

