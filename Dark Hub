local lastBoatBuy = 0
local sailStart

-- Tiki Outpost docks: boats are bought here before sailing out.
local TIKI_DOCK = Vector3.new(-16269.7, 25.2, 1373.4) -- approximate; the dealer NPC is used when found

local function boatDealerPos()
    local npcs = workspace:FindFirstChild("NPCs")
    local best, bestD = nil, math.huge
    if npcs then
        for _, n in ipairs(npcs:GetChildren()) do
            if n.Name:find("Boat", 1, true) then
                local okp, p = pcall(function() return n:GetPivot().Position end)
                if okp then
                    local d = (p - TIKI_DOCK).Magnitude
                    if d < bestD then best, bestD = p, d end
                end
            end
        end
    end
    -- only trust a dealer that is actually at Tiki Outpost
    if best and bestD < 1500 then return best end
    return TIKI_DOCK
end

-- Goes to Tiki Outpost, gets on the boat (buying it if needed) and sails
-- straight out to sea.
local function exploreSea(root, hum)
    local boat = myBoat()
    if not boat then
        -- 1) no boat yet: go to the Tiki Outpost boat dealer
        local dealer = boatDealerPos()
        if (root.Position - dealer).Magnitude > 40 then
            if hum.SeatPart then hum.Jump = true end
            setHover(true)
            local t = flyTo(CFrame.new(dealer + Vector3.new(0, 4, 0)))
            if t then t.Completed:Wait() end
            return true
        end
        -- 2) at the dealer: buy the selected boat
        if tick() - lastBoatBuy > 10 then
            lastBoatBuy = tick()
            sailStart = nil
            pcall(function()
                RS.Remotes.CommF_:InvokeServer("BuyBoat", BOAT_IDS[State.BoatName] or State.BoatName)
            end)
        end
        return true
    end

    local seat = boat:FindFirstChild("VehicleSeat") or boat:FindFirstChildWhichIsA("VehicleSeat", true)
    if not seat then return true end
    setHover(false)
    if hum.SeatPart ~= seat then
        root.CFrame = seat.CFrame * CFrame.new(0, 3, 0)
        return true
    end

    sailStart = sailStart or boat:GetPivot().Position
    if (boat:GetPivot().Position - sailStart).Magnitude < SAIL_MAX_DIST then
        boat:PivotTo(boat:GetPivot() + boat:GetPivot().LookVector * (SAIL_SPEED * 0.15))
    end
    return true
end

local function seaEvents()
    local root, hum = getRoot()
    if not root or not hum then return true end

    -- 1) an event is up: leave the boat and fight it
    local target, ev = findSeaTarget()
    if target then
        if hum.SeatPart then hum.Jump = true end
        setHover(true)
        local p = partOf(target)
        flyTo(p.CFrame * CFrame.new(0, SKILL_EVENTS[ev] and 55 or ATTACK_HEIGHT, 0))
        State.CombatUntil = tick() + 0.5
        if SKILL_EVENTS[ev] then State.SkillsUntil = tick() + 1 end
        return true
    end

    -- 2) no event: get on the boat and sail out to sea
    return exploreSea(root, hum)
end

