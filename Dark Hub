-- Throws every skill of every weapon type: Melee, Sword, Gun and Blox Fruit
local function allSkills()
    local char = Player.Character
    if not char then return end
    local keys = {Enum.KeyCode.Z, Enum.KeyCode.X, Enum.KeyCode.C, Enum.KeyCode.V, Enum.KeyCode.F}
    for _, kind in ipairs({"Melee", "Sword", "Gun", "Blox Fruit"}) do
        local tool
        local cur = char:FindFirstChildOfClass("Tool")
        if cur and cur.ToolTip == kind then
            tool = cur
        else
            for _, t in ipairs(Player.Backpack:GetChildren()) do
                if t:IsA("Tool") and t.ToolTip == kind then tool = t break end
            end
        end
        if tool then
            if tool.Parent ~= char then char.Humanoid:EquipTool(tool) end
            task.wait(0.15)
            for _, k in ipairs(keys) do
                pressKey(k)
                task.wait(0.2)
            end
        end
    end
end

