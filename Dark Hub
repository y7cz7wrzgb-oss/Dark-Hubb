-- Flies close to pos. Returns true once we are there.
local function flyNear(pos, radius, height)
    local root, hum = getRoot()
    if not root then return false end
    if (root.Position - pos).Magnitude <= radius then return true end
    if hum and hum.SeatPart then hum.Jump = true end
    setHover(true)
    local t = flyTo(CFrame.new(pos + Vector3.new(0, height or 4, 0)))
    if t then t.Completed:Wait() end
    return false
end

-- Buys the chip for the selected raid at the Mysterious Scientist.
-- The server only sells when you are standing next to him, so we fly there first.
local lastBuy, buyFails = 0, 0
local function buyChip()
    if not flyNear(scientistPos(), 25, 4) then return end
    if tick() - lastBuy < 5 then return end
    lastBuy = tick()

    if State.ChipSource == "Fruit" then
        local char = Player.Character
        for _, t in ipairs(Player.Backpack:GetChildren()) do
            if t:IsA("Tool") and t.ToolTip == "Blox Fruit" and char then
                char.Humanoid:EquipTool(t)
                break
            end
        end
    end
    pcall(function() RS.Remotes.CommF_:InvokeServer("RaidsNpc", "Select", State.RaidFruit) end)
    task.wait(1.2)

    if hasChip() then
        buyFails = 0
    else
        buyFails += 1
        if buyFails == 3 then
            Fluent:Notify({Title = "Dark Hub", Content = "Could not buy the chip. Check you have enough Beli / the fruit and that the raid is unlocked.", Duration = 8})
        end
    end
end

