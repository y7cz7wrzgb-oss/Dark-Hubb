-- Reads YOUR level, then picks the best quest for it in the current sea.
local function getLevelQuest()
    local lvl = getLevel()
    local age = tick() - levelCache.t
    if levelCache.lvl == lvl and (levelCache.data and age < 60 or age < 5) then
        return levelCache.data
    end
    levelCache.lvl, levelCache.t = lvl, tick()

    local ok, quests = pcall(function() return require(RS:WaitForChild("Quests", 5)) end)
    if not ok or type(quests) ~= "table" then
        levelCache.data = nil
        warn("[Dark Hub] could not read the game's quest list")
        return
    end

    -- strict = only quests whose mobs exist in this sea; the second pass
    -- ignores that check so a quest is always found
    local function pick(strict)
        local best, bestReq = nil, -1
        for questName, levels in pairs(quests) do
            if type(levels) == "table" then
                for idx, q in pairs(levels) do
                    if type(q) == "table" and q.LevelReq and q.Task and q.LevelReq <= lvl and q.LevelReq > bestReq then
                        local mobName, count
                        for n, c in pairs(q.Task) do mobName, count = n, c end
                        -- skip boss quests (kill 1)
                        if mobName and count and count > 1 and (not strict or questValid(mobName)) then
                            best, bestReq = {Name = questName, Level = idx, Mob = mobName}, q.LevelReq
                        end
                    end
                end
            end
        end
        return best
    end

    local best = pick(true) or pick(false)

    if not best then
        levelCache.data = nil
        if levelCache.warned ~= lvl then
            levelCache.warned = lvl
            Fluent:Notify({Title = "Dark Hub", Content = "Level " .. lvl .. ": no quest found in this sea. Travel to the right sea.", Duration = 8})
        end
        return
    end

    levelCache.data = {
        Mobs = {best.Mob},
        QuestMob = best.Mob,
        Label = best.Name .. " #" .. best.Level,
        Quest = {Name = best.Name, Level = best.Level, NPC = nil}, -- NPC position auto-detected
        Submerged = tostring(best.Name):find("Submerged") ~= nil or SUBMERGED_MOBS[best.Mob] == true,
    }
    local key = best.Name .. best.Level
    if levelCache.key ~= key then
        levelCache.key = key
        Fluent:Notify({Title = "Dark Hub", Content = "Level " .. lvl .. " -> farming " .. best.Mob .. " (" .. best.Name .. " #" .. best.Level .. ")", Duration = 6})
    end
    return levelCache.data
end

