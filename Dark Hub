---------------------------------------------------------------------
-- Farm loop
---------------------------------------------------------------------
task.spawn(function()
    while task.wait(0.15) do
        if not State.Farming then
            -- switched off: make sure nothing is left running
            if bv then setHover(false) end
            if currentTween and currentTween.PlaybackState == Enum.PlaybackState.Playing then currentTween:Cancel() end
            setStatus("Idle")
            continue
        end
        local ok, err = pcall(function()
            local root, hum = getRoot()
            if not root or not hum or hum.Health <= 0 then return end

            -- Priority: fruits > Elite Hunter > Castle Raid > method farm
            if State.CollectFruits and collectFruit() then return end
            if (State.Raid or State.BuyChip) and raidFarm() then return end
            if State.Elite and eliteHunter() then return end
            if State.Boss and bossFarm() then return end
            if (State.KitsuneFind or State.KitsuneAuto or State.CollectEmbers) and kitsuneTick() then return end
            if (State.MirageFind or State.MirageMoon or State.MirageV3 or State.MirageGears) and mirageTick() then return end
            if State.SeaEvent and seaEvents() then return end
            if State.Castle and castleRaid() then return end
            if not (State.StartFarm or State.GetQuest) then
                setHover(false)
                return
            end

            -- Level farm: first make sure we are in the sea that fits our level
            if State.Method == "Level" and CURRENT_SEA then
                local lvl = getLevel()
                local want = lvl >= 1500 and 3 or (lvl >= 700 and 2 or 1)
                if want ~= CURRENT_SEA and seaTravelTries < 3 then
                    setStatus("Lv " .. lvl .. " | travelling to Sea " .. want)
                    if tick() - lastSeaTravel > 20 then
                        lastSeaTravel = tick()
                        seaTravelTries += 1
                        Fluent:Notify({Title = "Dark Hub", Content = "Your level fits Sea " .. want .. ". Travelling there - run the script again after the teleport.", Duration = 10})
                        pcall(function() RS.Remotes.CommF_:InvokeServer(SEA_TRAVEL[want]) end)
                    end
                    return
                end
            end

            local data = State.Method == "Level" and getLevelQuest() or Methods[State.Method]
            if not data then
                setStatus("Lv " .. getLevel() .. " | no quest found in this sea")
                return
            end

            -- Level farm: if you already have a quest, kill ITS mob
            if State.Method == "Level" then
                local am = activeQuestMob()
                if am and am ~= data.Mobs[1] then
                    data = {Mobs = {am}, QuestMob = am, Label = "active quest", Quest = data.Quest,
                        Submerged = SUBMERGED_MOBS[am] == true}
                end
            end

            -- 0) quest is on Submerged Island: go down with the Submarine Worker first
            local lvlText = "Lv " .. getLevel() .. " | " .. (data.Label or State.Method) .. " | " .. (data.Mobs[1] or "?")
            if data.Submerged then
                -- already down there? (mob visible, spawn close, or we just travelled)
                local sp = findSpawn(data.Mobs)
                local inSub = findEnemy(data.Mobs) ~= nil
                    or (sp and (sp.Position - root.Position).Magnitude < 1500)
                    or tick() < (State.SubUntil or 0)
                if not inSub then
                    setStatus(lvlText .. " | going to Submerged Island")
                    goSubmerged()
                    return
                end
            end

            -- 1) quest: take it once, then only go back to the NPC after it is finished
            if State.GetQuest and data.Quest then
                if hasQuest() then
                    questGoneSince = nil
                else
                    questGoneSince = questGoneSince or tick()
                    if tick() - questGoneSince > 3 then
                        setStatus(lvlText .. " | taking quest")
                        takeQuest(data)
                        questGoneSince = nil
                    end
                end
            end

            -- 2) leave the NPC and go kill the mobs
            if farmMobs(data) then
                setStatus(lvlText .. " | fighting")
            else
                -- nothing alive: wait for respawn at the mob spawn point
                local sp = findSpawn(data.Mobs)
                setStatus(lvlText .. (sp and " | flying to the mobs" or " | spawn not found"))
                if sp then
                    setHover(true)
                    flyTo(sp.CFrame * CFrame.new(0, HOVER_HEIGHT + 8, 0))
                else
                    setHover(false)
                end
            end
        end)
        if not ok then warn("[Dark Hub] " .. tostring(err)) end
    end
end)

