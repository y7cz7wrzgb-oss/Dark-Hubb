local function raidFarm()
    if CURRENT_SEA == 1 then
        setStatus("Raid | raids only exist in Sea 2 and Sea 3")
        return false
    end
    local islands = raidIslands()
    local buyerIsMe = (State.ChipBuyer == "Me")

    -- only "Auto Buy Chip" is on: just keep a chip in the bag
    if not State.Raid then
        if State.BuyChip and buyerIsMe and #islands == 0 and not hasChip() then
            setStatus("Raid | buying the " .. State.RaidFruit .. " chip")
            buyChip()
            return true
        end
        return false
    end

    if #islands == 0 then
        if buyerIsMe then
            if not hasChip() then
                setStatus("Raid | buying the " .. State.RaidFruit .. " chip")
                buyChip()
            else
                setStatus("Raid | starting the raid at the console")
                startRaid()
            end
        else
            local present = Players:FindFirstChild(State.ChipBuyer) ~= nil
            setStatus("Raid | waiting on the platform for " .. tostring(State.ChipBuyer) .. (present and "" or " (not in this server)") .. " to start")
            waitAtPlatform()
        end
        return true
    end

    local root = getRoot()
    if not root then return true end
    local best, bestDist = nil, math.huge
    for _, mob in ipairs(workspace.Enemies:GetChildren()) do
        local hrp = mob:FindFirstChild("HumanoidRootPart")
        local hum = mob:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then
            for _, isl in ipairs(islands) do
                if (hrp.Position - isl.Position).Magnitude <= 700 then
                    local d = (hrp.Position - root.Position).Magnitude
                    if d < bestDist then best, bestDist = mob, d end
                    break
                end
            end
        end
    end

    setHover(true)
    if best then
        setStatus("Raid | fighting")
        bringMobs(best)
        best.HumanoidRootPart.CanCollide = false
        flyTo(best.HumanoidRootPart.CFrame * CFrame.new(0, ATTACK_HEIGHT, 0))
        State.CombatUntil = tick() + 0.5
    else
        -- island cleared: move on to the latest island so the next one spawns
        setStatus("Raid | going to the next island")
        flyTo(islands[#islands].CFrame * CFrame.new(0, 60, 0))
    end
    return true
end

