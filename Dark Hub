local VIM = game:GetService("VirtualInputManager")

local BOAT_LIST = {"Pirate Brigade", "Pirate Grand Brigade", "Marine Brigade", "Marine Grand Brigade", "Beast Hunter", "Sloop", "Dinghy"}
local BOAT_IDS = {
    ["Pirate Brigade"] = "PirateBrigade",
    ["Pirate Grand Brigade"] = "PirateGrandBrigade",
    ["Marine Brigade"] = "MarineBrigade",
    ["Marine Grand Brigade"] = "MarineGrandBrigade",
    ["Beast Hunter"] = "BeastHunter",
    ["Sloop"] = "Sloop",
    ["Dinghy"] = "Dinghy",
}
local SEA_EVENT_LIST = {"Terrorshark", "Sea Beast", "Piranha", "Fish Crew", "Pirate Brigade", "Ghost Ship"}
-- events where every skill (sword, melee, gun, fruit) is thrown
local SKILL_EVENTS = {["Sea Beast"] = true, ["Pirate Brigade"] = true, ["Ghost Ship"] = true}

local SAIL_SPEED = 150
local SAIL_MAX_DIST = 3500

local function partOf(model)
    return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
end

local function isMyBoat(boat)
    local owner = boat:FindFirstChild("Owner")
    return owner and owner.Value == Player
end

local function myBoat()
    local boats = workspace:FindFirstChild("Boats")
    if not boats then return end
    for _, b in ipairs(boats:GetChildren()) do
        if isMyBoat(b) then return b end
    end
end

-- Finds the closest selected event. Returns model, eventName
local function findSeaTarget()
    local root = getRoot()
    if not root then return end
    local best, bestEv, bestDist = nil, nil, math.huge

    local function consider(model, ev)
        local p = partOf(model)
        if p then
            local d = (p.Position - root.Position).Magnitude
            if d < bestDist then best, bestEv, bestDist = model, ev, d end
        end
    end

    for ev, on in pairs(State.SeaSelected) do
        if on then
            if ev == "Terrorshark" or ev == "Piranha" or ev == "Fish Crew" then
                local pattern = (ev == "Fish Crew") and "Fish Crew" or ev
                for _, m in ipairs(workspace.Enemies:GetChildren()) do
                    local hum = m:FindFirstChildOfClass("Humanoid")
                    if m.Name:find(pattern) and hum and hum.Health > 0 then consider(m, ev) end
                end
            elseif ev == "Sea Beast" then
                local folder = workspace:FindFirstChild("SeaBeasts")
                if folder then
                    for _, m in ipairs(folder:GetChildren()) do consider(m, ev) end
                end
            elseif ev == "Pirate Brigade" or ev == "Ghost Ship" then
                local boats = workspace:FindFirstChild("Boats")
                if boats then
                    for _, b in ipairs(boats:GetChildren()) do
                        if not isMyBoat(b) then
                            if (ev == "Pirate Brigade" and b.Name:find("Brigade")) or (ev == "Ghost Ship" and b.Name:find("Ghost")) then
                                consider(b, ev)
                            end
                        end
                    end
                end
            end
        end
    end
    return best, bestEv
end

local function pressKey(key)
    VIM:SendKeyEvent(true, key, false, game)
    task.wait(0.05)
    VIM:SendKeyEvent(false, key, false, game)
end

-- Race ability (V3 / the "T" button). Uses the game's remote so it works
