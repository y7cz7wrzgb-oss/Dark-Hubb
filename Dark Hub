-- Mirage Island: find it, climb to the highest point, look at the moon,
-- activate V3 (race ability) and collect gears.
-- NOTE: object names are best guesses and can change with updates.
---------------------------------------------------------------------
State.MirageFind = false
State.MirageMoon = false
State.MirageV3 = false
State.MirageGears = false

local Lighting = game:GetService("Lighting")
local mirageNotified = false
local mirageTop, mirageTopFor
local lastV3 = 0

local function mirageModel()
    local map = workspace:FindFirstChild("Map")
    return map and (map:FindFirstChild("MysticIsland") or map:FindFirstChild("Mirage Island"))
end

local function miragePos()
    local loc = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("Locations")
    local part = loc and (loc:FindFirstChild("Mirage Island") or loc:FindFirstChild("MirageIsland"))
    if part and part:IsA("BasePart") then return part.Position end
    local m = mirageModel()
    if m then return m:GetPivot().Position end
end

-- Highest point of the island (cached per island)
local function getMirageTop()
    local m = mirageModel()
    if not m then mirageTop, mirageTopFor = nil, nil return end
    if mirageTop and mirageTopFor == m then return mirageTop end
    local best
    for _, p in ipairs(m:GetDescendants()) do
        if p:IsA("BasePart") and (not best or p.Position.Y > best.Y) then best = p.Position end
    end
    mirageTop, mirageTopFor = best, m
    return best
end

local function findGear()
    local m = mirageModel()
    local root = getRoot()
    if not m or not root then return end
    local best, bestDist = nil, math.huge
    for _, o in ipairs(m:GetDescendants()) do
        if o.Name:find("Gear") then
            local p = o:IsA("BasePart") and o or o:FindFirstChildWhichIsA("BasePart", true)
            if p then
                local d = (p.Position - root.Position).Magnitude
                if d < bestDist then best, bestDist = p, d end
            end
        end
    end
    return best
end

local function restoreCamera()
    local cam = workspace.CurrentCamera
    if cam and cam.CameraType == Enum.CameraType.Scriptable then
        cam.CameraType = Enum.CameraType.Custom
    end
end

local function lookAtMoon()
    local cam = workspace.CurrentCamera
    if not cam then return end
    cam.CameraType = Enum.CameraType.Scriptable
    cam.CFrame = CFrame.lookAt(cam.CFrame.Position, cam.CFrame.Position + Lighting:GetMoonDirection())
end

-- Returns true while busy with Mirage Island tasks
local function mirageTick()
    local root, hum = getRoot()
    if not root or not hum then return true end

    local pos = miragePos()
    if not pos then
        return exploreSea(root, hum) -- keep sailing until Mirage Island spawns
    end
    if not mirageNotified then
        mirageNotified = true
        Fluent:Notify({Title = "Dark Hub", Content = "Mirage Island found!", Duration = 6})
    end

    -- Auto collect gears
    if State.MirageGears then
        local gear = findGear()
        if gear then
            if hum.SeatPart then hum.Jump = true end
            setHover(true)
            flyTo(gear.CFrame)
            pcall(function()
                firetouchinterest(root, gear, 0)
                firetouchinterest(root, gear, 1)
                local prompt = gear:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then fireproximityprompt(prompt) end
                local click = gear:FindFirstChildWhichIsA("ClickDetector", true)
                if click then fireclickdetector(click) end
            end)
            return true
        end
    end

    -- Highest point + look at the moon (+ V3)
    if State.MirageMoon or State.MirageV3 then
        local top = getMirageTop()
        if top then
            if hum.SeatPart then hum.Jump = true end
            setHover(true)
            local target = top + Vector3.new(0, 8, 0)
            if (root.Position - target).Magnitude > 12 then
                flyTo(CFrame.new(target))
            else
                lookAtMoon()
                if State.MirageV3 and tick() - lastV3 > 4 then
                    lastV3 = tick()
                    useRaceAbility() -- race ability (V3)
                end
            end
            return true
        end
    end
    return false
end

