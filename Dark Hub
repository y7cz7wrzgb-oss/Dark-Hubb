    return Player.Backpack:FindFirstChild("Special Microchip") or (char and char:FindFirstChild("Special Microchip"))
end

-- The raid console: Castle on the Sea (Sea 3) / Hot and Cold island (Sea 2)
local function raidConsole()
    local map = workspace:FindFirstChild("Map")
    if not map then return end
    local boat = map:FindFirstChild("Boat Castle")
    local circle = map:FindFirstChild("CircleIsland")
    local summon = (boat and boat:FindFirstChild("RaidSummon2")) or (circle and circle:FindFirstChild("RaidSummon"))
