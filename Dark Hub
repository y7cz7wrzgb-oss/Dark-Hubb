-- Fast attack: fires the game's combat remotes at every enemy in range,
-- so the player can hit from a distance. Falls back to normal clicking.
local Net = RS:FindFirstChild("Modules") and RS.Modules:FindFirstChild("Net")
local RegisterAttack = Net and Net:FindFirstChild("RE/RegisterAttack")
local RegisterHit = Net and Net:FindFirstChild("RE/RegisterHit")

local function enemiesInRange()
    local root = getRoot()
    local list = {}
    if not root then return list end
    for _, mob in ipairs(workspace.Enemies:GetChildren()) do
        local hrp = mob:FindFirstChild("HumanoidRootPart")
        local hum = mob:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 and (hrp.Position - root.Position).Magnitude <= ATTACK_RANGE then
            table.insert(list, mob)
        end
    end
    return list
end

local function attack()
    equipWeapon()
    local list = enemiesInRange()
    if State.Weapon == "Blox Fruit" then
        -- fruit M1: normal click
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(1280, 672))
        VirtualUser:Button1Up(Vector2.new(1280, 672))
    elseif State.FastAttack and RegisterAttack and RegisterHit and #list > 0 then
        local hits, first = {}, nil
        for _, mob in ipairs(list) do
            local part = mob:FindFirstChild("Head") or mob:FindFirstChild("HumanoidRootPart")
            if part then
                first = first or part
                table.insert(hits, {mob, part})
            end
        end
        pcall(function()
            RegisterAttack:FireServer(0)
            RegisterHit:FireServer(first, hits)
        end)
    else
        VirtualUser:CaptureController()
        VirtualUser:Button1Down(Vector2.new(1280, 672))
    end
end

local function findEnemy(names)
    local root = getRoot()
    if not root then return end
    local best, bestDist = nil, math.huge
    for _, mob in ipairs(workspace.Enemies:GetChildren()) do
        local hrp = mob:FindFirstChild("HumanoidRootPart")
        local hum = mob:FindFirstChildOfClass("Humanoid")
        if hrp and hum and hum.Health > 0 then
            for _, n in ipairs(names) do
                if mob.Name:find(n, 1, true) then
                    local d = (hrp.Position - root.Position).Magnitude
                    if d < bestDist then best, bestDist = mob, d end
                end
            end
        end
    end
    return best
end

-- Where mobs spawn (used when none are alive yet)
local function findSpawn(names)
    local root = getRoot()
    local folder = workspace:FindFirstChild("_WorldOrigin") and workspace._WorldOrigin:FindFirstChild("EnemySpawns")
    if not root or not folder then return end
    local best, bestDist = nil, math.huge
    for _, s in ipairs(folder:GetChildren()) do
        for _, n in ipairs(names) do
            if s.Name:find(n, 1, true) then
                -- spawns can be parts or models: always return a part
                local part = s:IsA("BasePart") and s or s:FindFirstChildWhichIsA("BasePart", true)
                if part then
                    local d = (part.Position - root.Position).Magnitude
                    if d < bestDist then best, bestDist = part, d end
                end
            end
        end
    end
    return best
end

-- True only while a quest is active AND not finished yet.
-- Reads the kill counter in the quest window (e.g. "Reborn Skeleton 3/8").
local function questUIActive()
    local gui = Player.PlayerGui:FindFirstChild("Main")
    local q = gui and gui:FindFirstChild("Quest")
    if not q or not q.Visible then return false end

    local ok, text = pcall(function()
        return q.Container.QuestTitle.Title.Text
    end)
    if ok and type(text) == "string" then
        local cur, max = text:match("(%d+)%s*/%s*(%d+)")
        if cur and max and tonumber(cur) >= tonumber(max) then
            return false -- finished: time to take the next quest
        end
    end
    return true
end

-- After taking a quest the window can take a moment to appear (or flicker),
-- so we trust the quest for a few seconds before judging by the window.
local questTakenAt = 0
local function hasQuest()
    if tick() - questTakenAt < 8 then return true end
    return questUIActive()
end

-- Flies to the quest NPC, takes the quest, then returns so the farm loop
-- sends the player to the mobs.
local lastQuestTry = 0
local questGoneSince = nil -- when the quest window disappeared (debounce)
local function takeQuest(data)
    if not data.Quest then return end
    if tick() - lastQuestTry < 6 then return end -- avoid ping-ponging to the NPC
    lastQuestTry = tick()
    -- NOTE: never abandon here. Abandoning is what used to cancel the
    -- quest you had just taken.

    local npcCF = data.Quest.NPC
    if not npcCF then
        -- no known NPC position: go near the mob spawn, quest NPCs are next to it
        local sp = findSpawn(data.Mobs)
        if sp then npcCF = sp.CFrame * CFrame.new(0, HOVER_HEIGHT, 0) end
    end
    if npcCF then
        local t, time = flyTo(npcCF)
        if t then t.Completed:Wait() end
    end
    if not State.Farming then return end -- switched off while flying
    local function start()
        pcall(function()
            RS.Remotes.CommF_:InvokeServer("StartQuest", data.Quest.Name, data.Quest.Level)
        end)
        task.wait(0.6)
    end
    start()

    -- not accepted? the quest NPC is probably a bit away from the spawn:
    -- go to the closest NPC and try again
    if not questUIActive() then
        local sp = findSpawn(data.Mobs)
        local npcs = workspace:FindFirstChild("NPCs")
        if sp and npcs then
            local bestPos, bestD = nil, 600
            for _, n in ipairs(npcs:GetChildren()) do
                local okp, p = pcall(function() return n:GetPivot().Position end)
                if okp then
                    local d = (p - sp.Position).Magnitude
                    if d < bestD then bestPos, bestD = p, d end
                end
            end
            if bestPos then
                local t = flyTo(CFrame.new(bestPos + Vector3.new(0, 4, 0)))
                if t then t.Completed:Wait() end
                start()
            end
        end
    end
    questTakenAt = tick()
end

