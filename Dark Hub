-- Bring Mob: pulls up to State.BringCount mobs of the same type onto the target
local function bringMobs(target)
    if not State.BringMob then return end
    local thrp = target:FindFirstChild("HumanoidRootPart")
    if not thrp then return end
    local count = 1
    for _, mob in ipairs(workspace.Enemies:GetChildren()) do
        if count >= State.BringCount then break end
        if mob ~= target and mob.Name == target.Name then
            local hrp = mob:FindFirstChild("HumanoidRootPart")
            local hum = mob:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 and (hrp.Position - thrp.Position).Magnitude <= 350 then
                hrp.CFrame = thrp.CFrame
                hrp.CanCollide = false
                count += 1
            end
        end
    end
end

-- Kills the closest enemy matching data (boss/mobs). Returns true if busy.
local function farmMobs(data)
    local target
    if data.Extra then target = findEnemy(data.Extra) end
    if not target and data.Boss then target = findEnemy({data.Boss}) end
    -- with a quest active, kill the quest's own mob first so it actually counts
    if not target and data.QuestMob and State.GetQuest then target = findEnemy({data.QuestMob}) end
    if not target and data.Mobs then target = findEnemy(data.Mobs) end

    if target then
        setHover(true)
        local hrp = target.HumanoidRootPart
        hrp.Size = Vector3.new(60, 60, 60)
        hrp.CanCollide = false
        bringMobs(target)
        flyTo(hrp.CFrame * CFrame.new(0, ATTACK_HEIGHT, 0))
        State.CombatUntil = tick() + 0.5
        return true
    end
    return false
end

-- Auto Collect Fruits: flies to any dropped fruit in the map
local function findFruit()
    local root = getRoot()
    if not root then return end
    local best, bestDist = nil, math.huge
    for _, obj in ipairs(workspace:GetChildren()) do
        if (obj:IsA("Tool") or obj:IsA("Model")) and obj.Name:find("Fruit") then
            local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart")
            if handle then
                local d = (handle.Position - root.Position).Magnitude
                if d < bestDist then best, bestDist = handle, d end
            end
        end
    end
    return best
end

local function collectFruit()
    local handle = findFruit()
    if not handle then return false end
    setHover(true)
    local root = getRoot()
    flyTo(handle.CFrame)
    if root then pcall(function() firetouchinterest(root, handle, 0) firetouchinterest(root, handle, 1) end) end
    return true
end

