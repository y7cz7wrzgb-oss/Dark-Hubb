local function getRoot()
    local char = Player.Character
    return char and char:FindFirstChild("HumanoidRootPart"), char and char:FindFirstChildOfClass("Humanoid")
end

local bv
local function setHover(on)
    local root = getRoot()
    if not root then return end
    -- never start hovering after everything was switched off
    if on and not State.Farming then return end
    if on then
        if not bv or bv.Parent ~= root then
            bv = Instance.new("BodyVelocity")
            bv.Name = "DarkHover"
            bv.Velocity = Vector3.zero
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Parent = root
        end
    elseif bv then
        bv:Destroy()
        bv = nil
    end
end

RunService.Stepped:Connect(function()
    if State.Farming and Player.Character then
        for _, p in ipairs(Player.Character:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
end)

local currentTween
local function flyTo(cf)
    -- once the farm is switched off no new flight may start; this was why
    -- "Star Farm" seemed not to turn off (a half-finished step kept flying)
    if not State.Farming then return end
    local root = getRoot()
    if not root then return end
    local dist = (root.Position - cf.Position).Magnitude
    if currentTween then currentTween:Cancel() end
    currentTween = TweenService:Create(root, TweenInfo.new(dist / FLY_SPEED, Enum.EasingStyle.Linear), {CFrame = cf})
    currentTween:Play()
    return currentTween, dist / FLY_SPEED
end

